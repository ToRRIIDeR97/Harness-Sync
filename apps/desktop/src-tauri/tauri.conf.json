{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Sync",
  "version": "0.1.0",
  "identifier": "app.harnesssync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Harness Sync", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:5173 ws://127.0.0.1:5173" }
  },
  "bundle": { "active": true, "targets": "all" }
}

